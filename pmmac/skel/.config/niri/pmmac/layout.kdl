// Gaps, borders and rounded corners for the pmMac look.
layout {
    gaps 4

    border {
        width 2
    }

    focus-ring {
        width 2
    }
}

window-rule {
    geometry-corner-radius 12
    clip-to-geometry true
    tiled-state true
    draw-border-with-background false
}

recent-windows {
    highlight {
        corner-radius 12
    }
}
